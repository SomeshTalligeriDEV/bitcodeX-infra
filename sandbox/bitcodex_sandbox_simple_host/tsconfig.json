{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": false,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@bitcodex-sdk-core/*": ["../../bitcodex_sdk_core/src/*"],
      "@bitcodex-sdk-eth/*": ["../../bitcodex_sdk_variants/eth/src/*"],
      "@bitcodex-sdk-cosmos/*": ["../../bitcodex_sdk_variants/cosmos/src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["src2"]
}
