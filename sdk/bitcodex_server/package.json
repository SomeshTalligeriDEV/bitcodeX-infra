{
  "name": "@bitcodex/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "del-cli dist",
    "build": "yarn clean && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@bitcodex/bittensor-chain": "workspace:*"
  },
  "devDependencies": {
    "del-cli": "^6.0.0",
    "typescript": "^5.8.3"
  }
}
