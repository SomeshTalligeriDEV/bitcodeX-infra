{
  "name": "@bitcodex/bittensor-chain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "del-cli dist",
    "build": "yarn clean && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:localnet": "BITTENSOR_LOCALNET=1 NODE_OPTIONS=--experimental-vm-modules jest --runInBand"
  },
  "dependencies": {
    "@bitcodex/stdlib-js": "workspace:*",
    "@polkadot/api": "17.0.2",
    "@polkadot/types": "17.0.2",
    "@polkadot/util": "14.0.3",
    "@polkadot/util-crypto": "14.0.3"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@polkadot/keyring": "14.0.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.10.1",
    "del-cli": "^6.0.0",
    "jest": "^30.1.3",
    "ts-jest": "^29.4.5",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.8.3"
  }
}
